# 复制为 .env 后填写。.env 已在 .gitignore 里，不会被提交。
#
#   cp .env.example .env
#
# docker compose 会自动读取同目录的 .env，不需要 --env-file。

# ---- 对外地址 ----
# BFS_BASE_URL 填浏览器访问的地址（OAuth 回跳和复制出去的链接都用它）
BFS_BASE_URL=https://bfs.example.com

# BFS_PATH_PREFIX 只在「挂在别人的子路径下」时才填，两种情况二选一：
#
#   A. 独立域名 / 二级域名（https://bfs.example.com/...）
#      BFS_PATH_PREFIX=            ← 留空，根部署
#      回调路径是 /api/auth/xxx/callback
#
#   B. 挂在别人域名的子目录下（https://other.com/bfs/...）
#      BFS_PATH_PREFIX=bfs
#      回调路径会变成 /bfs/api/auth/xxx/callback
#
# 填错的话 OAuth 会报 Unregistered Redirect URI —— 必须和提供商那边
# 登记的回调地址逐字符相同。启动日志会打印实际使用的回调地址。
BFS_PATH_PREFIX=

# ---- 登录：至少配一种，否则谁都能建分享 ----
# 方式一：一个密码（单人管理，没有账户历史、没有 CI token）
# BFS_ADMIN_PASSWORD=换成你自己的

# 方式二：Gitea 登录（三项都要填，少一项不生效）
# 启用 OAuth 后才有账户历史，才能创建 CI token
BFS_GITEA_URL=https://git.lotenall.com
BFS_GITEA_CLIENT_ID=
BFS_GITEA_CLIENT_SECRET=

# 方式三：GitHub 登录（三项都要填）
# BFS_GITHUB_CLIENT_ID=
# BFS_GITHUB_CLIENT_SECRET=
# BFS_GITHUB_ALLOWED_USERS=你的用户名

# ---- CI 上传 ----
# 用 token 上传的分享默认有效期（小时），0 = 永久
BFS_API_DEFAULT_TTL_HOURS=0

# ---- 页脚 ----
# 支持 HTML，用于备案号之类的带链接信息。留空则显示内置版权行。
# 示例（填写时去掉行首的 #）：
# BFS_FOOTER_HTML=<a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">粤ICP备00000000号-1</a> · BFS
